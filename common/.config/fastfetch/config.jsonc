{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    
    // Made by Aviel Skrypnyk
    // Repository:
    // https://github.com/AvielSkrypnyk/dotfiles

    "display": {
        "separator": "  ",
        "key": {
            "width": 13
        }
    },

    "logo": {
        "type": "builtin",
        "height": 16,
        "width": 30,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },

    "modules": [
        {
            "type": "custom",
            "format": "\u001b[38;2;202;211;245m┌─────────────────────── Hardware Information ───────────────────────┐\u001b[0m"
        },
        {
            "type": "host",
            "key": "\u001b[38;2;245;169;127m 󰌢 "
        },
        {
            "type": "cpu",
            "key": "\u001b[38;2;245;169;127m 󰍛 "
        },
        {
            "type": "gpu",
            "key": "\u001b[38;2;245;169;127m 󰘚 "
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;245;169;127m 󰑭 "
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;245;169;127m  "
        },
        {
            "type": "display",
            "key": "\u001b[38;2;245;169;127m 󰍹 "
        },
        {
            "type": "battery",
            "key": "\u001b[38;2;245;169;127m 󱈑 "
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;202;211;245m├─────────────────────── Software Information ───────────────────────┤\u001b[0m"
        },
        {
            "type": "os",
            "key": "\u001b[38;2;245;169;127m  "
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;245;169;127m  "
        },
        {
            "type": "de",
            "key": "\u001b[38;2;245;169;127m  "
        },
        {
            "type": "wm",
            "key": "\u001b[38;2;245;169;127m  "
        },
        {
            "type": "shell",
            "key": "\u001b[38;2;245;169;127m  "
        },
        {
            "type": "terminal",
            "key": "\u001b[38;2;245;169;127m  "
        },
        {
            "type": "terminalfont",
            "key": "\u001b[38;2;245;169;127m  "
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;245;169;127m 󰊠 "
        },
        {
            "type": "uptime",
            "key": "\u001b[38;2;245;169;127m 󰅐 "
        },
        {
            "type": "localip",
            "key": "\u001b[38;2;245;169;127m  "
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;202;211;245m└────────────────────────────────────────────────────────────────────┘\u001b[0m"
        },

        "break",

        {
            "type": "colors",
            "paddingLeft": 27,
            "symbol": "circle"
        }
    ]
}
