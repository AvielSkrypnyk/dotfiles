#!/usr/bin/env bash
# Switch the Starship prompt style (macOS / Linux).
#
#   starship-style          list styles and prompt for a name (Enter = default)
#   starship-style kali     switch straight to a style
#
# When prompting, show the current style if starship.toml is a symlink.
# ~/.config/starship.toml becomes a symlink to the chosen style, so edits to
# the style file show up on the next prompt.

set -euo pipefail

readonly STYLES_DIR="$HOME/dotfiles/common/.config/starship"
readonly TARGET="$HOME/.config/starship.toml"

style="${1:-}"

show_styles() {
    echo "Available styles:"
    ls "$STYLES_DIR" | sed 's/\.toml$//'
}

detect_active_style() {
    [[ ! -L $TARGET ]] && return

    local active_style
    active_style=$(basename "$(readlink "$TARGET")" .toml)

    echo "Current style: $active_style"
}

choose_style() {
    [[ -n $style ]] && return

    show_styles
    echo

    detect_active_style
    echo

    read -rp "Style (Enter = default): " style
    style="${style:-default}"
}

validate_style() {
    [[ -f "$STYLES_DIR/$style.toml" ]] || {
        echo "Unknown style: $style"
        exit 1
    }
}

apply_style() {
    mkdir -p "$HOME/.config"

    ln -sf \
        "$STYLES_DIR/$style.toml" \
        "$TARGET"

    echo "Starship style: $style"
}

main() {
    choose_style
    validate_style
    apply_style
}

main "$@"