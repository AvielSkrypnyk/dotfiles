<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
      <ProjectReference Include="..\Bunq.Core\Bunq.Core.csproj" />
      <ProjectReference Include="..\Bunq.Infrastructure\Bunq.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-preview.7.26381.103" />
    </ItemGroup>

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Bunq.Cli</RootNamespace>
        <AssemblyName>bunq</AssemblyName>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>bunq</ToolCommandName>
        <PackageId>Bunq.Cli</PackageId>
        <UseAppHost>false</UseAppHost>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

</Project>
